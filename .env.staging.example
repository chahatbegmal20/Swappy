# Staging template — set these in Render (API) + Vercel (web). Do not commit real values.

APP_ENV=staging
APP_DEBUG=false
# true = mock uploads on API disk until R2/S3 is configured
ALLOW_MOCK_STORAGE=true

DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=swappy_staging

REDIS_URL=

# Optional until you turn ALLOW_MOCK_STORAGE=false
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<r2_access_key_id>
S3_SECRET_KEY=<r2_secret_access_key>
S3_BUCKET=swappy-staging-uploads
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

JWT_SECRET=<generate-a-unique-32+-char-secret-for-staging>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

FRONTEND_URL=https://www.swappystudio.com
BACKEND_URL=https://<your-service>.onrender.com
# Keep vercel.app so previews / old links still work during the cutover
CORS_ALLOW_ORIGINS=https://swappy.vercel.app,https://swappystudio.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel (apps/web) project env:
# NEXT_PUBLIC_API_URL=https://<your-service>.onrender.com

