# Staging template — set these in Railway (API) + Vercel (web). Do not commit real values.

APP_ENV=staging
APP_DEBUG=false

DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=swappy_staging

REDIS_URL=redis://default:<password>@<upstash-or-railway-host>:6379

# Cloudflare R2 example (S3-compatible)
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<r2_access_key_id>
S3_SECRET_KEY=<r2_secret_access_key>
S3_BUCKET=swappy-staging-uploads
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

JWT_SECRET=<generate-a-unique-32+-char-secret-for-staging>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

FRONTEND_URL=https://swappy-staging.vercel.app
BACKEND_URL=https://swappy-api-staging.up.railway.app
CORS_ALLOW_ORIGINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel (apps/web) project env:
# NEXT_PUBLIC_API_URL=https://swappy-api-staging.up.railway.app
