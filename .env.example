# Database (MongoDB)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DATABASE_URL_SYNC=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=change mongo db name here

# Redis
REDIS_URL=change redis url here

# S3 / MinIO
S3_ENDPOINT=change s3 endpoint here
S3_ACCESS_KEY=change s3 access key here
S3_SECRET_KEY=change s3 secret key here
S3_BUCKET=change s3 bucket here

# Auth
JWT_SECRET=change jwt secret here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ML
MODEL_PATH=./data/models
DEVICE=cpu

# App
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
