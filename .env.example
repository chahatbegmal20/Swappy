# Database (MongoDB)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/swappy
DATABASE_URL_SYNC=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=swappy

# Redis (optional for local if you skip Celery)
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO (optional — without Docker the API uses local mock uploads)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=swappy-prod-uploads

# Auth
JWT_SECRET=swappy-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ML
MODEL_PATH=./data/models
DEVICE=cpu

# App
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000

# OAuth — leave blank to disable a provider (do not leave placeholder "your-*" values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
