# =============================================================================
# Swappy environment template (copy to .env for local development)
# Never commit real secrets. Use separate values per staging / production.
# =============================================================================

# development | staging | production
APP_ENV=development
APP_DEBUG=true

# Database (MongoDB Atlas recommended even for local)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DATABASE_URL_SYNC=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Use distinct DB names per environment, e.g. swappy_dev / swappy_staging / swappy_prod
MONGO_DB_NAME=swappy

# Redis (optional locally if you skip Celery workers)
REDIS_URL=redis://localhost:6379/0

# Object storage — MinIO locally; Cloudflare R2 or AWS S3 in staging/prod
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=swappy-uploads
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Auth — use a long random JWT_SECRET in staging/production (>= 32 chars)
JWT_SECRET=swappy-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ML
MODEL_PATH=./data/models
DEVICE=cpu

# Public URLs (must be https:// in staging/production)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
# Optional comma-separated extra CORS origins (Vercel preview URLs, etc.)
CORS_ALLOW_ORIGINS=

# Web (apps/web) — also set NEXT_PUBLIC_API_URL in Vercel project env
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# OAuth — leave blank to disable a provider
# Google redirect URI = {BACKEND_URL}/api/v1/auth/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
